# EarnGrind ingestion worker environment variables
# Copy this file to workers/.env and fill in the values.

# Supabase project URL (from Project Settings → API)
SUPABASE_URL=https://mgevesyscdxdwabaqmyx.supabase.co

# Supabase service-role key (from Project Settings → API → service_role key)
# Never expose this in the frontend. Keep it server-side only.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_b88y6a6jhiwQ2c4ZEBx_NQ_WUQlYSCT

# Full URL to the Edge Function (no trailing slash)
# Pattern: https://<project-ref>.supabase.co/functions/v1
SUPABASE_FUNCTION_URL=https://mgevesyscdxdwabaqmyx.supabase.co/functions/v1

# Provider to use — "mock" is safe for local testing
# Options: mock | adgate-media | offertoro | all
PROVIDER=mock

# ── Adgate Media ──────────────────────────────────────────────────────────────
# Publisher credentials from https://adgatemedia.com/publishers/
# Leave blank to use fixture mode (reads from providers/fixtures/adgate-media.json)
ADGATE_APP_ID=
ADGATE_SECRET_KEY=

# Force fixture mode even when credentials are set
ADGATE_USE_FIXTURE=false

# ── OfferToro ─────────────────────────────────────────────────────────────────
# Publisher credentials from https://www.offertoro.com/api
# Leave blank to use fixture mode (reads from providers/fixtures/offertoro.json)
OFFERTORO_APP_KEY=
OFFERTORO_PUB_ID=

# Force fixture mode even when credentials are set
OFFERTORO_USE_FIXTURE=false

# GPT offer ingestion service
INGEST_SOURCE=gain-gg
INGEST_INTERVAL_HOURS=12
GAIN_USE_MOCK=true
GAIN_API_URL=https://gain.gg/api/v2/offers
GAIN_API_LIMIT=300
GAIN_ADTOWALL_URL=https://adtowall.com
GAIN_ADTOWALL_SOURCE_URL=https://gain.gg/earn
GAIN_ADTOWALL_HAR_FILE=
GAIN_ADTOWALL_ENRICH_TASKS=true
GAIN_ADTOWALL_MODAL_CONCURRENCY=4
GAIN_ADTOWALL_METHOD=GET
GAIN_ADTOWALL_HEADERS_JSON=
GAIN_ADTOWALL_BODY=
GAIN_ADTOWALL_RESPONSE_FILE=
GAIN_ADTOWALL_RESPONSE_JSON=
GAIN_ADTOWALL_HTML=
GAIN_MYCHIPS_API_URL=https://api.mychips.io/v1.6/campaigns
GAIN_MYCHIPS_CONTENT_ID=
GAIN_MYCHIPS_USER_ID=
GAIN_MYCHIPS_CLICK_ID=
GAIN_MYCHIPS_LANGUAGE=en
GAIN_MYCHIPS_LIMIT=10
GAIN_REVU_API_URL=https://api-wall.revenueuniverse.com/offers.php
GAIN_REVU_API_KEY=
GAIN_REVU_ID=
GAIN_REVU_TYPE=desktop
GEMSLOOT_USE_MOCK=false
GEMSLOOT_HAR_FILE=
GEMSLOOT_SITE_URL=https://gemsloot.com/earn
GEMSLOOT_ENRICH_TASKS=true
GEMSLOOT_DETAIL_CONCURRENCY=8
GEMSLOOT_PROVIDER_FILTER=
GEMSLOOT_MAX_PAGES=
EARNLAB_USE_MOCK=true
EARNLAB_TOROX_BOOTSTRAP_URL=https://api.earnlab.com/tasks/walls/torox
EARNLAB_TOROX_FRAME_URL=
EARNLAB_TOROX_BOOTSTRAP_REFERER=https://earnlab.com/earn
EARNLAB_TOROX_BOOTSTRAP_ORIGIN=https://earnlab.com
EARNLAB_TOROX_BOOTSTRAP_COOKIE=
EARNLAB_TOROX_COOKIE=
EARNLAB_TOROX_BOOTSTRAP_HEADERS_JSON=
EARNLAB_TOROX_HEADERS_JSON=
EARNLAB_TOROX_CAMPAIGNS_URL=https://api.wall.torox.io/player/campaigns
EARNLAB_TOROX_SETTINGS_URL=https://api.wall.torox.io/player/settings
EARNLAB_TOROX_OS=web,ios,android
EARNLAB_TOROX_LIMIT=100
EARNLAB_TOROX_BOOST_MULTIPLIER=1.8
DEFAULT_COUNTRY=US
DEFAULT_PLATFORM=web
DEFAULT_DEVICE=desktop
