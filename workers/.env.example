# EarnGrind ingestion worker environment variables
# Copy this file to workers/.env and fill in the values.

# Supabase project URL (from Project Settings → API)
SUPABASE_URL=https://mgevesyscdxdwabaqmyx.supabase.co

# Supabase service-role key (from Project Settings → API → service_role key)
# Never expose this in the frontend. Keep it server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Full URL to the Edge Function (no trailing slash)
# Pattern: https://<project-ref>.supabase.co/functions/v1
SUPABASE_FUNCTION_URL=https://mgevesyscdxdwabaqmyx.supabase.co/functions/v1

# Provider to use — "mock" is safe for local testing
# Options: mock | adgate-media | offertoro | all
PROVIDER=mock

# ── Adgate Media ──────────────────────────────────────────────────────────────
# Publisher credentials from https://adgatemedia.com/publishers/
# Leave blank to use fixture mode (reads from providers/fixtures/adgate-media.json)
ADGATE_APP_ID=
ADGATE_SECRET_KEY=

# Force fixture mode even when credentials are set
ADGATE_USE_FIXTURE=false

# ── OfferToro ─────────────────────────────────────────────────────────────────
# Publisher credentials from https://www.offertoro.com/api
# Leave blank to use fixture mode (reads from providers/fixtures/offertoro.json)
OFFERTORO_APP_KEY=
OFFERTORO_PUB_ID=

# Force fixture mode even when credentials are set
OFFERTORO_USE_FIXTURE=false

# GPT offer ingestion service
INGEST_SOURCE=gain-gg
INGEST_INTERVAL_HOURS=12
CASHINSTYLE_USE_MOCK=true
CASHINSTYLE_API_URL=https://cashinstyle.com/walls/torox
CASHINSTYLE_HEADERS_JSON=
CASHINSTYLE_COOKIE=
CASHINSTYLE_LIMIT=100
CASHINSTYLE_SITE_URL=https://cashinstyle.com
CASHINSTYLE_WALL_URL=https://cashinstyle.com/walls/torox
